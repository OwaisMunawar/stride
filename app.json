{
  "expo": {
    "name": "Stride",
    "slug": "stride",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stride",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.owaismunawar.stride",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true
      }
    },
    "android": {
      "package": "com.owaismunawar.stride",
      "adaptiveIcon": {
        "backgroundColor": "#0D0F12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.READ_PHONE_STATE"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0D0F12",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Stride uses your location to draw your route and measure distance while you record. It stays on this phone.",
          "locationAlwaysAndWhenInUsePermission": "Allow Always so Stride keeps recording your run when the screen is locked. Your route stays on this phone.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-sqlite",
      "expo-widgets",
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-sharing",
      "expo-asset",
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
