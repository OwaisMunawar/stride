# Copy to .env.local. Every EXPO_PUBLIC_ value is inlined into the app bundle,
# so none of these may ever hold a secret.

# Seed ten fictional runs and show "Simulate run" (replays a bundled GPX at 10x).
EXPO_PUBLIC_DEMO=1

# Optional: an OpenAI-compatible endpoint for the server coach, e.g. your own
# proxy that holds the provider key, or a local model server on your network.
# Leave empty to keep the coach fully on device.
EXPO_PUBLIC_COACH_ENDPOINT=
EXPO_PUBLIC_COACH_MODEL=gpt-4.1-mini
